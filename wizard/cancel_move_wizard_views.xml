<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_pos_cash_move_cancel_wizard_form" model="ir.ui.view">
        <field name="name">pos.cash.move.cancel.wizard.form</field>
        <field name="model">pos.cash.move.cancel.wizard</field>
        <field name="arch" type="xml">

            <form string="Anular Movimiento">

                <group>
                    <field name="move_id"/>
                </group>

                <group>
                    <field name="reason"
                           placeholder="Escriba el motivo de la anulación..."/>
                </group>

                <footer>
                    <button name="action_confirm_cancel"
                            type="object"
                            string="Confirmar Anulación"
                            class="btn-danger"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>